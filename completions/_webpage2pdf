#compdef webpage2pdf w2p
# zsh completion for webpage2pdf

_webpage2pdf_styles() {
    local -a styles
    # Query the installed tool rather than hardcoding, so a stylesheet dropped
    # into styles/ completes immediately.
    styles=( ${(f)"$(webpage2pdf --list-styles 2>/dev/null)"} )
    _describe -t styles 'stylesheet' styles
}

_webpage2pdf_profiles() {
    local -a p
    p=( ${(f)"$(webpage2pdf --list-profiles 2>/dev/null | awk '{print $1}')"} )
    _describe -t profiles 'profile' p
}

_arguments -s -S \
  '(-h --help)'{-h,--help}'[show help and exit]' \
  '(-V --version)'{-V,--version}'[show version and exit]' \
  '(-o --output)'{-o,--output}'[exact output PDF path (single source only)]:pdf file:_files -g "*.pdf"' \
  '(-d --dir)'{-d,--dir}'[output directory; names come from article titles]:directory:_files -/' \
  '--from-list[read sources from a file, one per line]:list file:_files' \
  '--style[stylesheet name]:style:_webpage2pdf_styles' \
  '(-p --profile)'{-p,--profile}'[named bundle of settings]:profile:_webpage2pdf_profiles' \
  '(-f --format)'{-f,--format}'[output format]:format:((
      pdf\:"typeset for paper"
      html\:"one self-contained file"
      epub\:"reflowable, for an e-reader"
      md\:"Markdown with front matter"))' \
  '--list-profiles[show available profiles and exit]' \
  '(-j --jobs)'{-j,--jobs}'[fetch this many pages at once]:jobs:' \
  '--no-cache[do not read or write the fetch cache]' \
  '--refresh[re-fetch even when a cached copy is held]' \
  '--cache-info[show what the cache holds and exit]' \
  '--clear-cache[empty the cache and exit]' \
  '--fix[with --doctor, attempt the repairs it recommends]' \
  '--preset[page geometry]:preset:((
      a4\:"A4 portrait, 25mm margins (default)"
      letter\:"US Letter, 1in margins"
      a5\:"A5 - half of A4, one-handed"
      book\:"6x9in trim, facing pages with mirrored margins"
      remarkable\:"reMarkable 2 e-ink screen"
      two-column\:"A4 in two columns"))' \
  '(--no-toc)--toc[add a contents list with page numbers]' \
  '(--toc)--no-toc[never add a contents list]' \
  '--list-presets[show available page presets and exit]' \
  '--open[open each finished PDF in the default viewer]' \
  '--links[how to treat links]:mode:((
      plain\:"strip link styling — cleanest on paper"
      endnotes\:"superscript markers plus a numbered list at the end"
      footnotes\:"each URL at the foot of the page it appears on"
      keep\:"leave links live and underlined"))' \
  '--no-numbering[omit automatic section and figure numbers]' \
  '--no-images[text only — smaller files, faster]' \
  '--no-url[omit the source URL from the title block]' \
  '--no-standfirst[omit the italic summary line under the title]' \
  '--keep-html[also save the cleaned HTML]:html file:_files -g "*.html"' \
  '--timeout[network timeout per request, seconds]:seconds:' \
  '--cookies[send cookies from a file, for pages you read signed in]:cookie file:_files' \
  '--list-styles[show available stylesheets and exit]' \
  '--doctor[check the installation and report what is wrong]' \
  '(-q --quiet)'{-q,--quiet}'[only print errors]' \
  '*:source:_files -g "*.(html|htm)"'
